BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/speechmirror.sqlite3?mode=rwc
STORAGE_DIR=data
JWT_SECRET=replace-with-at-least-32-random-characters
RUST_LOG=speechmirror_api=info,tower_http=info
# Optional comma-separated browser origins. Native mobile clients do not need CORS.
CORS_ALLOWED_ORIGINS=

# DeepSeek handles LLM reasoning only. Do not reuse this key for ASR, OCR, or embeddings.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Configure each remaining capability with its actual provider and credential.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_MODEL=paraformer-v2
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=
OCR_MODEL=qwen-vl-plus

PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
LIBREOFFICE_BIN=libreoffice
TESSERACT_BIN=tesseract
TESSERACT_LANG=chi_sim+eng
